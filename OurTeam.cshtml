@page
@model RecruitCatChaudhnt.Pages.OurTeamModel
@{
    ViewData["Title"] = "Our Team";
}

<div class="container py-5">
    <!-- Page Heading -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">Meet Our Team</h1>
        <p class="lead text-muted">Passionate professionals dedicated to helping companies and candidates succeed.</p>
    </div>

    <!-- Team Grid -->
    <div class="row g-4">
        <!-- Member 1 -->
        <div class="col-md-4">
            <div class="card shadow-lg h-100">
                <img src="~/images/nav_p.jpg" class="card-img-top" alt="Navedita Chaudhary">
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">Navedita Chaudhary</h5>
                    <p class="card-text text-muted">Founder & CEO</p>
                    <p class="small">
                        I’m a motivated and result-oriented individual with a strong background in leadership,
                        problem solving, and customer support. I enjoy empowering others and bringing innovative
                        solutions to life.
                    </p>
                    <a href="mailto:chaudhnt@mail.uc.edu" class="btn btn-outline-primary btn-sm">Contact</a>
                </div>
            </div>
        </div>

        <!-- Member 2 -->
        <div class="col-md-4">
            <div class="card shadow-lg h-100">
                <img src="~/images/alex_p.webp" class="card-img-top" alt="Alex Johnson">
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">Alex Johnson</h5>
                    <p class="card-text text-muted">Head of Talent Acquisition</p>
                    <p class="small">
                        Alex brings over 10 years of experience in HR and recruitment, specializing in building
                        long-term partnerships between clients and candidates. His passion is finding the right
                        fit for every role.
                    </p>
                    <a href="#" class="btn btn-outline-primary btn-sm">Connect</a>
                </div>
            </div>
        </div>

        <!-- Member 3 -->
        <div class="col-md-4">
            <div class="card shadow-lg h-100">
                <img src="~/images/sophia_p.jpg" class="card-img-top" alt="Sophia Patel">
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">Sophia Patel</h5>
                    <p class="card-text text-muted">Marketing & Communications Lead</p>
                    <p class="small">
                        Sophia is a creative storyteller with a background in digital marketing.
                        She helps RecruitCat stand out by designing campaigns that connect
                        with audiences on a deeper level.
                    </p>
                    <a href="#" class="btn btn-outline-primary btn-sm">Portfolio</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Industries Section -->
    <div class="my-5">
        <h2 class="fw-bold text-center mb-4">Industries We Specialize In</h2>
        <div class="row text-center g-4">
            <div class="col-md-3">
                <img src="~/images/technology_p.webp" alt="Technology" class="img-fluid mb-2" style="height:100px;">
                <p>Technology</p>
            </div>
            <div class="col-md-3">
                <img src="~/images/healthcare_p.jpg" alt="Healthcare" class="img-fluid mb-2" style="height:100px;">
                <p>Healthcare</p>
            </div>
            <div class="col-md-3">
                <img src="~/images/finance_p.jpg" alt="Finance" class="img-fluid mb-2" style="height:100px;">
                <p>Finance</p>
            </div>
            <div class="col-md-3">
                <img src="~/images/manufacturing_p.webp" alt="Manufacturing" class="img-fluid mb-2" style="height:100px;">
                <p>Manufacturing</p>
            </div>
        </div>
    </div>
</div>