@page
@model RecruitCatChaudhnt.Pages.companys.IndexModel

@{
    ViewData["Title"] = "All Companies";
}

<h1>All Companies</h1>

<p>
    <a class="btn btn-primary" asp-page="Create">Create a New Company</a>
</p>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Company[0].Name)</th>
            <th>@Html.DisplayNameFor(model => model.Company[0].PositionName)</th>
            <th>Salary Range</th>
            <th>Industry</th>
            <th>Job Title</th>
            <th>@Html.DisplayNameFor(model => model.Company[0].IsRemoteFriendly)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Company)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.PositionName</td>
                <td>@item.MinSalary.ToString("C") - @item.MaxSalary.ToString("C")</td>
                <td>@item.Industry?.Name</td>
                <td>@item.JobTitle?.Title</td>
                <td>@(item.IsRemoteFriendly ? "Yes" : "No")</td>
                <td>
                    <a class="btn btn-sm btn-outline-warning" asp-page="./Edit" asp-route-id="@item.CompanyId">Edit</a>
                    <a class="btn btn-sm btn-outline-info" asp-page="./Details" asp-route-id="@item.CompanyId">Details</a>
                    <a class="btn btn-sm btn-outline-danger" asp-page="./Delete" asp-route-id="@item.CompanyId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
