@page
@model RecruitCatChaudhnt.Pages.companys.IndexModel

@{
    ViewData["Title"] = "Companies";
}

<h1>Companies</h1>

<p>
    <a class="btn btn-primary" asp-page="Create">Create New Company</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Company[0].Name)</th>
            <th>@Html.DisplayNameFor(model => model.Company[0].PositionName)</th>
            <th>@Html.DisplayNameFor(model => model.Company[0].MinSalary)</th>
            <th>@Html.DisplayNameFor(model => model.Company[0].MaxSalary)</th>
            <th>@Html.DisplayNameFor(model => model.Company[0].StartDate)</th>
            <th>@Html.DisplayNameFor(model => model.Company[0].Location)</th>
            <th>@Html.DisplayNameFor(model => model.Company[0].NumEmployees)</th>
            <th>@Html.DisplayNameFor(model => model.Company[0].Revenue)</th>
            <th>@Html.DisplayNameFor(model => model.Company[0].IsRemoteFriendly)</th>
            <th>Industry</th>
            <th>Job Title</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Company)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.PositionName)</td>
                <td>@Html.DisplayFor(modelItem => item.MinSalary)</td>
                <td>@Html.DisplayFor(modelItem => item.MaxSalary)</td>
                <td>@Html.DisplayFor(modelItem => item.StartDate)</td>
                <td>@Html.DisplayFor(modelItem => item.Location)</td>
                <td>@Html.DisplayFor(modelItem => item.NumEmployees)</td>
                <td>@Html.DisplayFor(modelItem => item.Revenue)</td>
                <td>@Html.DisplayFor(modelItem => item.IsRemoteFriendly)</td>
                <td>@item.Industry?.Name</td>
                <td>@item.JobTitle?.Title</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.CompanyId">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.CompanyId">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.CompanyId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
