@page
@model RecruitCatChaudhnt.Pages.companys.DetailsModel

@{
    ViewData["Title"] = "Company Details";
}

<h1>Company Details</h1>

<div>
    <h4>@Model.Company.Name</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Company.PositionName)</dt>
        <dd class="col-sm-9">@Model.Company.PositionName</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Company.MinSalary)</dt>
        <dd class="col-sm-9">@Model.Company.MinSalary.ToString("C")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Company.MaxSalary)</dt>
        <dd class="col-sm-9">@Model.Company.MaxSalary.ToString("C")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Company.StartDate)</dt>
        <dd class="col-sm-9">@Model.Company.StartDate?.ToString("d")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Company.Location)</dt>
        <dd class="col-sm-9">
            <pre class="bg-light p-2 rounded">@Model.Company.Location</pre> @* ✅ multiline textarea display *@
        </dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Company.NumEmployees)</dt>
        <dd class="col-sm-9">@Model.Company.NumEmployees</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Company.Revenue)</dt>
        <dd class="col-sm-9">@Model.Company.Revenue.ToString("C")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Company.IsRemoteFriendly)</dt>
        <dd class="col-sm-9">@(Model.Company.IsRemoteFriendly ? "Yes" : "No")</dd>

        <dt class="col-sm-3">Industry</dt>
        <dd class="col-sm-9">@Model.Company.Industry?.Name</dd>

        <dt class="col-sm-3">Job Title</dt>
        <dd class="col-sm-9">@Model.Company.JobTitle?.Title</dd>
    </dl>
</div>

<hr />

<h4>Candidates Associated with @Model.Company.Name</h4>

@if (Model.Company.Candidates != null && Model.Company.Candidates.Any())
{
    <table class="table table-striped table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Target Salary</th>
                <th>Job Title</th>
                <th>Start Date</th>
                <th>Currently Employed</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var candidate in Model.Company.Candidates)
            {
                <tr>
                    <td>@candidate.FirstName</td>
                    <td>@candidate.LastName</td>
                    <td>@candidate.TargetSalary.ToString("C")</td>
                    <td>@candidate.JobTitle?.Title</td>
                    <td>@candidate.StartDate?.ToString("d")</td>
                    <td>@(candidate.IsCurrentlyEmployed ? "Yes" : "No")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No candidates are currently associated with this company.</p>
}

<div class="mt-3">
    <a class="btn btn-warning" asp-page="./Edit" asp-route-id="@Model.Company.CompanyId">Edit</a>
    <a class="btn btn-secondary" asp-page="./Index">Back to List</a>
</div>
