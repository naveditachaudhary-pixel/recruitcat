@page
@model RecruitCatChaudhnt.Pages.candidates.DetailsModel

@{
    ViewData["Title"] = "Candidate Details";
}

<h1>Candidate Details</h1>

<div>
    <h4>Candidate</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Candidate.FirstName)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Candidate.FirstName)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Candidate.LastName)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Candidate.LastName)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Candidate.TargetSalary)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Candidate.TargetSalary)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Candidate.StartDate)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Candidate.StartDate)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Candidate.DateOfBirth)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Candidate.DateOfBirth)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Candidate.Email)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Candidate.Email)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Candidate.Phone)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Candidate.Phone)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Candidate.IsCurrentlyEmployed)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Candidate.IsCurrentlyEmployed)</dd>

        <dt class="col-sm-2">Company</dt>
        <dd class="col-sm-10">@Model.Candidate.Company?.Name</dd>

        <dt class="col-sm-2">Job Title</dt>
        <dd class="col-sm-10">@Model.Candidate.JobTitle?.Title</dd>
    </dl>
</div>

<div>
    <a class="btn btn-warning" asp-page="./Edit" asp-route-id="@Model.Candidate.CandidateId">Edit</a> |
    <a class="btn btn-secondary" asp-page="./Index">Back to List</a>
</div>
