@page
@model RecruitCatChaudhnt.Pages.candidates.DetailsModel

@{
    ViewData["Title"] = "Candidate Details";
}

<h1>Candidate Details</h1>

<div>
    <h4>@Model.Candidate.FirstName @Model.Candidate.LastName</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Candidate.FirstName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Candidate.FirstName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Candidate.LastName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Candidate.LastName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Candidate.TargetSalary)</dt>
        <dd class="col-sm-9">@Model.Candidate.TargetSalary.ToString("C")</dd> @* Shows currency *@

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Candidate.StartDate)</dt>
        <dd class="col-sm-9">@Model.Candidate.StartDate?.ToString("d")</dd> @* Only date, no time *@

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Candidate.DateOfBirth)</dt>
        <dd class="col-sm-9">@Model.Candidate.DateOfBirth.ToString("d")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Candidate.Email)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Candidate.Email)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Candidate.Phone)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Candidate.Phone)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Candidate.IsCurrentlyEmployed)</dt>
        <dd class="col-sm-9">@(Model.Candidate.IsCurrentlyEmployed ? "Yes" : "No")</dd>

        <dt class="col-sm-3">Company</dt>
        <dd class="col-sm-9">@Model.Candidate.Company?.Name</dd>

        <dt class="col-sm-3">Job Title</dt>
        <dd class="col-sm-9">@Model.Candidate.JobTitle?.Title</dd>

        <dt class="col-sm-3">Industry</dt>
        <dd class="col-sm-9">@Model.Candidate.Company?.Industry?.Name</dd> @* ✅ Shows related Industry name *@
    </dl>
</div>

<div>
    <a class="btn btn-warning" asp-page="./Edit" asp-route-id="@Model.Candidate.CandidateId">Edit</a>
    <a class="btn btn-secondary" asp-page="./Index">Back to List</a>
</div>
