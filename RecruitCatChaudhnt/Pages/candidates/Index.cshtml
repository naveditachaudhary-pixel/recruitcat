@page
@model RecruitCatChaudhnt.Pages.candidates.IndexModel

@{
    ViewData["Title"] = "Candidates";
}

<h1>Candidates</h1>

<p>
    <a class="btn btn-primary" asp-page="Create">Create New Candidate</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Candidate[0].FirstName)</th>
            <th>@Html.DisplayNameFor(model => model.Candidate[0].LastName)</th>
            <th>@Html.DisplayNameFor(model => model.Candidate[0].TargetSalary)</th>
            <th>@Html.DisplayNameFor(model => model.Candidate[0].StartDate)</th>
            <th>@Html.DisplayNameFor(model => model.Candidate[0].DateOfBirth)</th>
            <th>@Html.DisplayNameFor(model => model.Candidate[0].Email)</th>
            <th>@Html.DisplayNameFor(model => model.Candidate[0].Phone)</th>
            <th>@Html.DisplayNameFor(model => model.Candidate[0].IsCurrentlyEmployed)</th>
            <th>Company</th>
            <th>Job Title</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Candidate)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.FirstName)</td>
                <td>@Html.DisplayFor(modelItem => item.LastName)</td>
                <td>@Html.DisplayFor(modelItem => item.TargetSalary)</td>
                <td>@Html.DisplayFor(modelItem => item.StartDate)</td>
                <td>@Html.DisplayFor(modelItem => item.DateOfBirth)</td>
                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                <td>@Html.DisplayFor(modelItem => item.Phone)</td>
                <td>@Html.DisplayFor(modelItem => item.IsCurrentlyEmployed)</td>
                <td>@item.Company?.Name</td>
                <td>@item.JobTitle?.Title</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.CandidateId">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.CandidateId">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.CandidateId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
