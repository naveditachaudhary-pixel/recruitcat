@page
@model RecruitCatChaudhnt.Pages.jobtitles.DetailsModel

@{
    ViewData["Title"] = "Job Title Details";
}

<h1>Job Title Details</h1>

<div class="card shadow-sm p-4">
    <h4>@Model.JobTitle.Title</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Salary Range</dt>
        <dd class="col-sm-9">
            @Model.JobTitle.MinSalary.ToString("C") - @Model.JobTitle.MaxSalary.ToString("C")
        </dd>

        <dt class="col-sm-3">Level</dt>
        <dd class="col-sm-9">@Model.JobTitle.Level</dd>

        <dt class="col-sm-3">Years of Experience</dt>
        <dd class="col-sm-9">@Model.JobTitle.YearsOfExperience</dd>
    </dl>
</div>

<div class="mt-3">
    <a class="btn btn-warning" asp-page="./Edit" asp-route-id="@Model.JobTitle.JobTitleId">Edit</a>
    <a class="btn btn-secondary" asp-page="./Index">Back to List</a>
</div>
