@page
@model RecruitCatChaudhnt.Pages.jobtitles.IndexModel

@{
    ViewData["Title"] = "Job Titles";
}

<h1>Job Titles</h1>

<p>
    <a class="btn btn-primary" asp-page="Create">Create New Job Title</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.JobTitle[0].Title)</th>
            <th>@Html.DisplayNameFor(model => model.JobTitle[0].MinSalary)</th>
            <th>@Html.DisplayNameFor(model => model.JobTitle[0].MaxSalary)</th>
            <th>@Html.DisplayNameFor(model => model.JobTitle[0].Level)</th>
            <th>@Html.DisplayNameFor(model => model.JobTitle[0].YearsOfExperience)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.JobTitle)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Title)</td>
                <td>@Html.DisplayFor(modelItem => item.MinSalary)</td>
                <td>@Html.DisplayFor(modelItem => item.MaxSalary)</td>
                <td>@Html.DisplayFor(modelItem => item.Level)</td>
                <td>@Html.DisplayFor(modelItem => item.YearsOfExperience)</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.JobTitleId">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.JobTitleId">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.JobTitleId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
