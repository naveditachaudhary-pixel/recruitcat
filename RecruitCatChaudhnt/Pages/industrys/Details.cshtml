@page
@model RecruitCatChaudhnt.Pages.industrys.DetailsModel

@{
    ViewData["Title"] = "Industry Details";
}

<h1>Industry Details</h1>

<div class="card shadow-sm p-4">
    <h4>@Model.Industry.Name</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Industry.Description</dd>

        <dt class="col-sm-2">Growing?</dt>
        <dd class="col-sm-10">
            @(Model.Industry.IsGrowing ? "Yes" : "No")
        </dd>
    </dl>
</div>

<div class="mt-3">
    <a class="btn btn-warning" asp-page="./Edit" asp-route-id="@Model.Industry.IndustryId">Edit</a>
    <a class="btn btn-secondary" asp-page="./Index">Back to List</a>
</div>
